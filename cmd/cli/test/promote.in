// RUN local-deployment
// RUN promote-root

ais bucket create ais://$BUCKET // IGNORE
rm -rf /var/lib/ais/promote/prm // IGNORE
mkdir -p /var/lib/ais/promote/prm && echo 012345 > /var/lib/ais/promote/prm/obj && echo 012345 > /var/lib/ais/promote/prm/discard
ais object promote /var/lib/ais/promote/prm/obj ais://$BUCKET/one/one --delete-src=false --target-id $RANDOM_TARGET
ls /var/lib/ais/promote/prm/obj
ais object promote /var/lib/ais/promote/prm/discard ais://$BUCKET/two/ --delete-src=true  --target-id $RANDOM_TARGET
ls /var/lib/ais/promote/prm/discard // FAIL "such file or directory"
ais object promote /var/lib/ais/promote/prm/ ais://$BUCKET/three/ --delete-src=false --target-id $RANDOM_TARGET
ais object promote /var/lib/ais/promote/prm ais://$BUCKET/fourth/ --target-id $RANDOM_TARGET
ais object promote /var/lib/ais/promote/prm ais://$BUCKET/fifth/ --delete-src=false --target-id $RANDOM_TARGET
ais object promote /var/lib/ais/promote/prm/ ais://$BUCKET/sixth/ --target-id $RANDOM_TARGET
ais bucket ls ais://$BUCKET
rm -rf /var/lib/ais/promote/prm // IGNORE
ais bucket rm ais://$BUCKET -y // IGNORE

ais bucket create ais://$BUCKET // IGNORE
mkdir -p /var/lib/ais/promote/prm
for f in {11..15}; do echo "$RANDOM -- $RANDOM" > /var/lib/ais/promote/prm/$f.txt; done
ais object promote /var/lib/ais/promote/prm ais://$BUCKET
ais ls ais://$BUCKET --name-only -H
ais object rm ais://$BUCKET --template "{1..100}.txt" // IGNORE
ais ls ais://$BUCKET

rm -rf /var/lib/ais/promote/prm // IGNORE
mkdir -p /var/lib/ais/promote/prm/subdir
for f in {11..15}; do echo "$RANDOM -- $RANDOM" > /var/lib/ais/promote/prm/subdir/$f.txt; done
ais object promote -r /var/lib/ais/promote/prm ais://$BUCKET
ais ls ais://$BUCKET --name-only -H

# --overwrite-dst

echo "QQQQQQQQQQQQ" > /var/lib/ais/promote/prm/qq; ais object promote /var/lib/ais/promote/prm/qq ais://$BUCKET --overwrite-dst > /dev/null; ais ls ais://$BUCKET -H --regex=qq
echo "" > /var/lib/ais/promote/prm/qq; ais object promote /var/lib/ais/promote/prm/qq ais://$BUCKET > /dev/null; ais ls ais://$BUCKET -H --regex=qq
echo "" > /var/lib/ais/promote/prm/qq; ais object promote /var/lib/ais/promote/prm/qq ais://$BUCKET --overwrite-dst > /dev/null; ais ls ais://$BUCKET -H --regex=qq
echo "QQQQQQQQQQQQ" > /var/lib/ais/promote/prm/qq; ais object promote /var/lib/ais/promote/prm/qq ais://$BUCKET --overwrite-dst=false > /dev/null; ais ls ais://$BUCKET -H --regex=qq
echo "QQQQQQQQQQQQ" > /var/lib/ais/promote/prm/qq; ais object promote /var/lib/ais/promote/prm/qq ais://$BUCKET --overwrite-dst=true > /dev/null; ais ls ais://$BUCKET -H --regex=qq
ls /var/lib/ais/promote/prm/qq

# delete-src when not overwring
echo "" > /var/lib/ais/promote/prm/qq; ais object promote /var/lib/ais/promote/prm/qq ais://$BUCKET --delete-src > /dev/null
ls /var/lib/ais/promote/prm/qq // FAIL "such file or directory"
ais ls ais://$BUCKET -H --regex=qq

rm -rf /var/lib/ais/promote/prm > /dev/null
ais bucket rm ais://$BUCKET --yes > /dev/null
